rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(m) { return m == 'a' || m == 'b'; }
    function validName(s, max) { return s is string && s.size() > 0 && s.size() <= max; }
    function validHours(h) { return h is number && h >= 0.25 && h <= 40; }
    function validDay(d) { return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function validPence(n, min) { return n is int && n >= min && n <= 1000000; }
    function validBlock(n) { return n is int && n >= 5 && n <= 240 && n % 5 == 0; }

    match /households/{code} {
      allow get: if signedIn();
      allow list, delete: if false;
      allow create, update: if signedIn()
        && code.matches('^[a-z]+-[a-z]+-[a-z]+-[0-9]{4}$')
        && request.resource.data.keys().hasOnly(['members', 'createdAt'])
        && validName(request.resource.data.members.a.name, 30)
        && validName(request.resource.data.members.b.name, 30)
        && request.resource.data.createdAt is number;

      match /chores/{choreId} {
        allow read, delete: if signedIn();
        allow create, update: if signedIn()
          && request.resource.data.keys().hasOnly(['name', 'hours', 'assignee', 'createdAt', 'archivedAt', 'blockMinutes'])
          && validName(request.resource.data.name, 60)
          && validHours(request.resource.data.hours)
          && isMember(request.resource.data.assignee)
          && request.resource.data.createdAt is number
          && (request.resource.data.archivedAt == null || request.resource.data.archivedAt is number)
          && (!('blockMinutes' in request.resource.data) || validBlock(request.resource.data.blockMinutes));
      }

      match /settings/{docId} {
        allow read: if signedIn();
        allow create, update: if signedIn() && docId == 'app'
          && request.resource.data.keys().hasOnly(['timeZone', 'currency'])
          && validName(request.resource.data.timeZone, 64)
          && request.resource.data.currency == 'GBP';
      }

      match /budgets/{budgetId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && request.resource.data.keys().hasOnly(['name', 'owner', 'monthlyAmount', 'penalty', 'order', 'createdAt', 'archivedAt'])
          && validName(request.resource.data.name, 30)
          && request.resource.data.owner in ['a', 'b', 'shared']
          && validPence(request.resource.data.monthlyAmount, 0)
          && request.resource.data.penalty is bool
          && request.resource.data.order is int
          && request.resource.data.createdAt is number
          && (request.resource.data.archivedAt == null || request.resource.data.archivedAt is number);
      }

      match /money/{entryId} {
        allow read, delete: if signedIn();
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['budgetId', 'by', 'day', 'amount', 'label', 'kind', 'createdAt'])
          && request.resource.data.budgetId is string && request.resource.data.budgetId.size() > 0 && request.resource.data.budgetId.size() <= 100
          && isMember(request.resource.data.by)
          && validDay(request.resource.data.day)
          && request.resource.data.label is string && request.resource.data.label.size() <= 40
          && ((request.resource.data.kind in ['purchase', 'bank'] && validPence(request.resource.data.amount, 1))
              || (request.resource.data.kind == 'nothing' && request.resource.data.amount == 0))
          && request.resource.data.createdAt is number;
      }

      match /weeks/{weekId} {
        allow read, delete: if signedIn();
        allow create, update: if signedIn()
          && weekId.matches('^[0-9]{4}-W[0-9]{2}$')
          && request.resource.data.keys().hasOnly(['weekId'])
          && request.resource.data.weekId == weekId;

        match /completions/{choreId} {
          allow read, delete: if signedIn();
          allow create, update: if signedIn()
            && request.resource.data.keys().hasOnly(['percent', 'name', 'hours', 'assignee', 'updatedAt'])
            && request.resource.data.percent in [0, 25, 50, 75, 100]
            && validName(request.resource.data.name, 60)
            && validHours(request.resource.data.hours)
            && isMember(request.resource.data.assignee)
            && request.resource.data.updatedAt is number;
        }

        match /feedback/{feedbackId} {
          allow read, delete: if signedIn();
          allow create, update: if signedIn()
            && request.resource.data.keys().hasOnly(['from', 'to', 'kind', 'text', 'createdAt', 'resolved'])
            && isMember(request.resource.data.from)
            && isMember(request.resource.data.to)
            && request.resource.data.from != request.resource.data.to
            && request.resource.data.kind in ['plus', 'minus']
            && validName(request.resource.data.text, 280)
            && request.resource.data.createdAt is number
            && request.resource.data.resolved is bool;
        }

        match /logs/{logId} {
          allow read, delete: if signedIn();
          allow create: if signedIn()
            && request.resource.data.keys().hasOnly(['choreId', 'name', 'by', 'multiplier', 'minutes', 'day', 'createdAt'])
            && request.resource.data.choreId is string && request.resource.data.choreId.size() > 0 && request.resource.data.choreId.size() <= 100
            && validName(request.resource.data.name, 60)
            && isMember(request.resource.data.by)
            && request.resource.data.multiplier in [1, 2, 3]
            && request.resource.data.minutes is int && request.resource.data.minutes >= 5 && request.resource.data.minutes <= 720
            && request.resource.data.day is string && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && request.resource.data.createdAt is number;
        }
      }
    }
  }
}
