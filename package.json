{
  "name": "responsible-2gether",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emu": "VITE_USE_EMULATOR=1 vite",
    "emulators": "firebase emulators:start --project demo-r2g",
    "build": "tsc --noEmit && tsc --noEmit -p worker && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --project demo-r2g --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "icons": "pwa-assets-generator --preset minimal-2023 public/icon.svg",
    "deploy": "npm test && npm run build && npx wrangler deploy"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "firebase": "^13.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261013.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-tools": "^13.35.1",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
