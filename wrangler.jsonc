// 2gether.imansaraei.com on Cloudflare Workers (free tier):
// - static PWA from ./dist via the assets binding
// - worker/index.ts handles /api/* (daily-reminder push subscriptions) and the reminder cron
{
  "name": "responsible-2gether",
  "account_id": "11d78f38d1720bec6a3d70aa8e4bf71a",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only API calls invoke the script; everything else is served straight from assets.
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "SUBS", "id": "6244f3a04cd14bc5b672e57d734b50fc" }
  ],
  // Every 15 minutes; the worker sends to devices where it is 10:00 or 22:00 locally.
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "VAPID_PUBLIC_KEY": "BIf9NAqCLKdaDY5aq032eNdcndShlqEQza91s5ZIGa3l2CONqXtRN0ndsjlWeCSerWD6B9hdKnggJQVLN9Fxq6I",
    "VAPID_CONTACT": "https://2gether.imansaraei.com"
  },
  // VAPID_PRIVATE_KEY is a secret: `npx wrangler secret put VAPID_PRIVATE_KEY`
  "observability": { "enabled": true },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "2gether.imansaraei.com", "custom_domain": true }
  ]
}
